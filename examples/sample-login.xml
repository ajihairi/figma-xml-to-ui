<?xml version="1.0" encoding="UTF-8"?>
<!--
  FigML sample export — "Login / Screen"
  Canvas: iPhone 14 (390 x 844 artboard padding included below), frame 375 x 812.
  Every frame here uses auto-layout, so it exercises the flex mapping path only.

  Expected output (use as the parity checklist):
    1. Nav bar: back arrow left, centered "Sign In" title, invisible 24px balance on the right.
    2. Header: "Welcome back" (28/36, 700) over "Sign in to keep your streak alive." (15/22, muted).
    3. Email field: mail icon, muted placeholder "you@example.com", white fill, 1px #E4E4E7 border, radius 12.
    4. Password field: lock icon, masked value, trailing eye icon.
    5. Right-aligned "Forgot password?" link.
    6. Full-width dark CTA "Sign in" with a soft drop shadow.
    7. Divider: rules on both sides of "or continue with".
    8. Two equal social buttons: Google and Apple, each with an icon and label.
    9. Footer: muted "Don't have an account?" followed by a bold "Sign up".
-->
<figma version="1.0" exporter="figml" name="Sample Login">
  <frame
    id="1:1"
    name="Login / Screen"
    type="FRAME"
    x="0" y="0"
    width="375" height="812"
    layoutMode="VERTICAL"
    layoutSizingHorizontal="FIXED"
    layoutSizingVertical="FIXED"
    itemSpacing="28"
    paddingTop="56"
    paddingBottom="32"
    paddingLeft="24"
    paddingRight="24"
    fill="#FAFAFA"
    clipsContent="true">

    <!-- 1. Nav bar -->
    <frame
      id="1:2"
      name="Nav Bar"
      type="FRAME"
      width="327" height="24"
      layoutMode="HORIZONTAL"
      layoutSizingHorizontal="FILL"
      layoutSizingVertical="HUG"
      primaryAxisAlignItems="SPACE_BETWEEN"
      counterAxisAlignItems="CENTER">
      <instance id="1:3" name="Icon / arrow-left" componentId="icon-arrow-left" width="24" height="24" color="#18181B">
        <vector id="1:4" name="arrow-left-path" width="24" height="24" fill="#18181B"/>
      </instance>
      <text
        id="1:5"
        name="Title"
        type="TEXT"
        content="Sign In"
        width="60" height="24"
        fontSize="16" fontWeight="600" lineHeight="24" letterSpacing="0"
        textAlignHorizontal="CENTER"
        color="#18181B"/>
      <rectangle id="1:6" name="Nav Balance" width="24" height="24" opacity="0"/>
    </frame>

    <!-- 2. Header -->
    <frame
      id="1:7"
      name="Header"
      type="FRAME"
      width="327" height="66"
      layoutMode="VERTICAL"
      layoutSizingHorizontal="FILL"
      layoutSizingVertical="HUG"
      itemSpacing="8"
      counterAxisAlignItems="MIN">
      <text
        id="1:8"
        name="Heading"
        type="TEXT"
        content="Welcome back"
        width="327" height="36"
        fontSize="28" fontWeight="700" lineHeight="36" letterSpacing="-0.5"
        textAlignHorizontal="LEFT"
        color="#18181B"
        layoutSizingHorizontal="FILL"/>
      <text
        id="1:9"
        name="Subtitle"
        type="TEXT"
        content="Sign in to keep your streak alive."
        width="327" height="22"
        fontSize="15" fontWeight="400" lineHeight="22" letterSpacing="0"
        textAlignHorizontal="LEFT"
        color="#71717A"
        layoutSizingHorizontal="FILL"/>
    </frame>

    <!-- 3. Form -->
    <frame
      id="1:10"
      name="Form"
      type="FRAME"
      width="327" height="156"
      layoutMode="VERTICAL"
      layoutSizingHorizontal="FILL"
      layoutSizingVertical="HUG"
      itemSpacing="16"
      counterAxisAlignItems="MIN">

      <frame
        id="1:11"
        name="Input / Email"
        type="FRAME"
        width="327" height="52"
        layoutMode="HORIZONTAL"
        layoutSizingHorizontal="FILL"
        layoutSizingVertical="HUG"
        itemSpacing="12"
        paddingTop="14" paddingBottom="14" paddingLeft="16" paddingRight="16"
        counterAxisAlignItems="CENTER"
        cornerRadius="12"
        fill="#FFFFFF"
        strokeColor="#E4E4E7"
        strokeWeight="1">
        <instance id="1:12" name="Icon / mail" componentId="icon-mail" width="20" height="20" color="#71717A">
          <vector id="1:13" name="mail-path" width="20" height="20" fill="#71717A"/>
        </instance>
        <text
          id="1:14"
          name="Placeholder"
          type="TEXT"
          content="you@example.com"
          width="263" height="22"
          fontSize="15" fontWeight="400" lineHeight="22" letterSpacing="0"
          textAlignHorizontal="LEFT"
          color="#A1A1AA"
          layoutSizingHorizontal="FILL"/>
      </frame>

      <frame
        id="1:15"
        name="Input / Password"
        type="FRAME"
        width="327" height="52"
        layoutMode="HORIZONTAL"
        layoutSizingHorizontal="FILL"
        layoutSizingVertical="HUG"
        itemSpacing="12"
        paddingTop="14" paddingBottom="14" paddingLeft="16" paddingRight="16"
        counterAxisAlignItems="CENTER"
        cornerRadius="12"
        fill="#FFFFFF"
        strokeColor="#E4E4E7"
        strokeWeight="1">
        <instance id="1:16" name="Icon / lock" componentId="icon-lock" width="20" height="20" color="#71717A">
          <vector id="1:17" name="lock-path" width="20" height="20" fill="#71717A"/>
        </instance>
        <text
          id="1:18"
          name="Value"
          type="TEXT"
          content="••••••••"
          width="231" height="22"
          fontSize="15" fontWeight="400" lineHeight="22" letterSpacing="2"
          textAlignHorizontal="LEFT"
          color="#18181B"
          layoutSizingHorizontal="FILL"/>
        <instance id="1:19" name="Icon / eye" componentId="icon-eye" width="20" height="20" color="#71717A">
          <vector id="1:20" name="eye-path" width="20" height="20" fill="#71717A"/>
        </instance>
      </frame>

      <text
        id="1:21"
        name="Link / Forgot Password"
        type="TEXT"
        content="Forgot password?"
        width="327" height="20"
        fontSize="13" fontWeight="600" lineHeight="20" letterSpacing="0"
        textAlignHorizontal="RIGHT"
        color="#18181B"
        layoutSizingHorizontal="FILL"/>
    </frame>

    <!-- 4. Primary CTA -->
    <frame
      id="1:22"
      name="Button / Primary"
      type="FRAME"
      width="327" height="52"
      layoutMode="HORIZONTAL"
      layoutSizingHorizontal="FILL"
      layoutSizingVertical="HUG"
      primaryAxisAlignItems="CENTER"
      counterAxisAlignItems="CENTER"
      paddingTop="14" paddingBottom="14" paddingLeft="16" paddingRight="16"
      cornerRadius="12"
      fill="#18181B">
      <effect type="DROP_SHADOW" x="0" y="8" blur="24" spread="0" color="#18181B" opacity="0.18"/>
      <text
        id="1:23"
        name="Label"
        type="TEXT"
        content="Sign in"
        width="60" height="24"
        fontSize="16" fontWeight="600" lineHeight="24" letterSpacing="0"
        textAlignHorizontal="CENTER"
        color="#FAFAFA"/>
    </frame>

    <!-- 5. Divider -->
    <frame
      id="1:24"
      name="Divider"
      type="FRAME"
      width="327" height="20"
      layoutMode="HORIZONTAL"
      layoutSizingHorizontal="FILL"
      layoutSizingVertical="HUG"
      itemSpacing="12"
      primaryAxisAlignItems="CENTER"
      counterAxisAlignItems="CENTER">
      <rectangle
        id="1:25"
        name="Rule Left"
        width="94" height="1"
        layoutSizingHorizontal="FILL"
        fill="#E4E4E7"/>
      <text
        id="1:26"
        name="Label"
        type="TEXT"
        content="or continue with"
        width="115" height="20"
        fontSize="13" fontWeight="400" lineHeight="20" letterSpacing="0"
        textAlignHorizontal="CENTER"
        color="#71717A"/>
      <rectangle
        id="1:27"
        name="Rule Right"
        width="94" height="1"
        layoutSizingHorizontal="FILL"
        fill="#E4E4E7"/>
    </frame>

    <!-- 6. Social buttons -->
    <frame
      id="1:28"
      name="Social Row"
      type="FRAME"
      width="327" height="52"
      layoutMode="HORIZONTAL"
      layoutSizingHorizontal="FILL"
      layoutSizingVertical="HUG"
      itemSpacing="12">
      <frame
        id="1:29"
        name="Button / Google"
        type="FRAME"
        width="157" height="52"
        layoutMode="HORIZONTAL"
        layoutSizingHorizontal="FILL"
        layoutSizingVertical="HUG"
        itemSpacing="8"
        primaryAxisAlignItems="CENTER"
        counterAxisAlignItems="CENTER"
        paddingTop="14" paddingBottom="14" paddingLeft="12" paddingRight="12"
        cornerRadius="12"
        fill="#FFFFFF"
        strokeColor="#E4E4E7"
        strokeWeight="1">
        <instance id="1:30" name="brand-google" componentId="brand-google" width="20" height="20" color="#18181B">
          <vector id="1:31" name="google-path" width="20" height="20" fill="#18181B"/>
        </instance>
        <text
          id="1:32"
          name="Label"
          type="TEXT"
          content="Google"
          width="53" height="22"
          fontSize="15" fontWeight="600" lineHeight="22" letterSpacing="0"
          textAlignHorizontal="LEFT"
          color="#18181B"/>
      </frame>
      <frame
        id="1:33"
        name="Button / Apple"
        type="FRAME"
        width="157" height="52"
        layoutMode="HORIZONTAL"
        layoutSizingHorizontal="FILL"
        layoutSizingVertical="HUG"
        itemSpacing="8"
        primaryAxisAlignItems="CENTER"
        counterAxisAlignItems="CENTER"
        paddingTop="14" paddingBottom="14" paddingLeft="12" paddingRight="12"
        cornerRadius="12"
        fill="#FFFFFF"
        strokeColor="#E4E4E7"
        strokeWeight="1">
        <instance id="1:34" name="brand-apple" componentId="brand-apple" width="20" height="20" color="#18181B">
          <vector id="1:35" name="apple-path" width="20" height="20" fill="#18181B"/>
        </instance>
        <text
          id="1:36"
          name="Label"
          type="TEXT"
          content="Apple"
          width="41" height="22"
          fontSize="15" fontWeight="600" lineHeight="22" letterSpacing="0"
          textAlignHorizontal="LEFT"
          color="#18181B"/>
      </frame>
    </frame>

    <!-- Flexible spacer pushes the footer to the bottom -->
    <rectangle
      id="1:40"
      name="Spacer"
      width="327" height="0"
      layoutSizingVertical="FILL"
      fill="#FAFAFA"
      opacity="0"/>

    <!-- 7. Footer -->
    <frame
      id="1:37"
      name="Footer"
      type="FRAME"
      width="327" height="20"
      layoutMode="HORIZONTAL"
      layoutSizingHorizontal="FILL"
      layoutSizingVertical="HUG"
      itemSpacing="4"
      primaryAxisAlignItems="CENTER"
      counterAxisAlignItems="CENTER">
      <text
        id="1:38"
        name="Prompt"
        type="TEXT"
        content="Don't have an account?"
        width="153" height="20"
        fontSize="13" fontWeight="400" lineHeight="20" letterSpacing="0"
        textAlignHorizontal="LEFT"
        color="#71717A"/>
      <text
        id="1:39"
        name="Link / Sign up"
        type="TEXT"
        content="Sign up"
        width="49" height="20"
        fontSize="13" fontWeight="600" lineHeight="20" letterSpacing="0"
        textAlignHorizontal="LEFT"
        color="#18181B"/>
    </frame>

  </frame>
</figma>

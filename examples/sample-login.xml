<?xml version="1.0" encoding="UTF-8"?>
<?figml version="1.0"?>
<!--
  FigML sample export — "Login / Screen", 375 x 812.

  Schema notes:
    - children live inside <children>
    - paints/effects are child elements, not attributes
    - instance tags are component names, sanitized to valid XML names
    - x/y are relative to the parent and informational inside auto-layout

  Expected output (parity checklist):
    1. Nav bar: back arrow left, centered "Sign In", invisible 24px balance right.
    2. Header: "Welcome back" (28/36, 700) over "Sign in to keep your streak alive." (15/22, muted).
    3. Email field: mail icon, muted "you@example.com", white fill, 1px #E4E4E7 INSIDE stroke, radius 12.
    4. Password field: lock icon, 8 masked chars, trailing eye icon.
    5. Right-aligned "Forgot password?" (13/20, 600).
    6. Full-width #18181B CTA "Sign in" with 0/8/24 drop shadow at 18% opacity.
    7. Divider: 1px rules both sides of "or continue with".
    8. Two equal social buttons, Google and Apple.
    9. Footer: muted "Don't have an account?" + 600 "Sign up".
-->
<frame id="1:1" name="Login / Screen" type="FRAME"
